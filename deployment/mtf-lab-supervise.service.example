# PLANTILLA DE REFERENCIA SOLAMENTE.
# No instalar, no enable y no start desde este archivo sin autorización
# operativa separada.  El modo fixture/observe no contacta al bróker ni envía
# órdenes; el nombre de la unidad no constituye una activación.
[Unit]
Description=MTF Lab cTrader supervisor (template, disabled by default)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=3

[Service]
Type=notify
User=winterboss
WorkingDirectory=/home/winterboss/MTF
StateDirectory=mtf-lab
Environment=PYTHONUNBUFFERED=1
Environment=MTF_LAB_STATE_DIR=%S/mtf-lab
ExecStart=/home/winterboss/MTF/mtf-lab ctrader supervise --fixture --mode observe --state-dir %S/mtf-lab/supervision --db %S/mtf-lab/supervision/capture.sqlite3 --duration 30 --max-events 100 --watchdog
Restart=on-failure
RestartSec=10s
NotifyAccess=main
WatchdogSec=90s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/mtf-lab
UMask=0077

# The [Install] section is intentionally commented: this example is not an
# enabled unit and must be reviewed before any local deployment.
# [Install]
# WantedBy=multi-user.target
